{
  "name": "skill-library",
  "version": "0.2.0",
  "description": "A skill library for AI agents: skills load on demand through one query (vercel-labs/skills-compatible CLI)",
  "keywords": [
    "skills",
    "agent-skills",
    "ai-agents",
    "claude-code",
    "codex",
    "opencode",
    "cli"
  ],
  "homepage": "https://github.com/ianwijma/skill-library-skill#readme",
  "bugs": {
    "url": "https://github.com/ianwijma/skill-library-skill/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianwijma/skill-library-skill.git"
  },
  "license": "MIT",
  "author": "Ian Wijma",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "skill-library": "dist/skill-library"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ThirdPartyNotices.txt"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm pack --dry-run"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@types/node": "^22.18.0",
    "@types/semver": "^7.8.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "esbuild": "^0.28.2",
    "picocolors": "^1.1.1",
    "semver": "^7.8.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
