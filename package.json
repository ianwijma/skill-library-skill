{
  "name": "skill-library",
  "version": "0.4.0",
  "description": "A skill library for AI agents: skills load on demand through one query (vercel-labs/skills-compatible CLI)",
  "keywords": [
    "skills",
    "agent-skills",
    "ai-agents",
    "claude-code",
    "codex",
    "opencode",
    "cli"
  ],
  "homepage": "https://github.com/ianwijma/skill-library-skill#readme",
  "bugs": {
    "url": "https://github.com/ianwijma/skill-library-skill/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianwijma/skill-library-skill.git"
  },
  "license": "MIT",
  "author": "Ian Wijma",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "skill-library": "dist/skill-library"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ThirdPartyNotices.txt"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node src/index.ts",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:live": "node scripts/e2e.mjs --live",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm pack --dry-run"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@commander-js/extra-typings": "~15.1.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.18.0",
    "@types/semver": "^7.8.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "@typescript/typescript6": "^6.0.2",
    "commander": "~15.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/parser": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/eslint-plugin": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/typescript-estree": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/type-utils": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/utils": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/project-service": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/tsconfig-utils": {
      "typescript": "$typescript"
    },
    "ts-api-utils": {
      "typescript": "$typescript"
    }
  }
}
